/* =========================================================
   ROAD TEXTURE
========================================================= */

function createRoadTexture() {
  const canvas = document.createElement("canvas");

  canvas.width = 1024;
  canvas.height = 2048;

  const ctx = canvas.getContext("2d");

  const random = seededRandom(913);

  ctx.fillStyle = "#171c21";

  ctx.fillRect(0, 0, canvas.width, canvas.height);

  /* Asphalt grain */
  for (let i = 0; i < 18000; i++) {
    const x = random() * canvas.width;

    const y = random() * canvas.height;

    const shade = 22 + Math.floor(random() * 22);

    ctx.fillStyle = `rgba(${shade},${shade + 3},${shade + 7},${0.08 + random() * 0.13})`;

    const size = 1 + random() * 2.2;

    ctx.fillRect(x, y, size, size);
  }

  /* Road repairs */
  for (let i = 0; i < 24; i++) {
    const x = 100 + random() * 824;

    const y = random() * 2048;

    const width = 40 + random() * 120;

    const height = 15 + random() * 42;

    ctx.fillStyle = "rgba(0,0,0,0.18)";

    ctx.fillRect(x, y, width, height);

    ctx.strokeStyle = "rgba(94,104,110,0.12)";

    ctx.lineWidth = 2;

    ctx.strokeRect(x, y, width, height);
  }

  /* Road stains */
  for (let i = 0; i < 15; i++) {
    const x = 120 + random() * 780;

    ctx.fillStyle = "rgba(0,0,0,0.10)";

    ctx.fillRect(x, 0, 5 + random() * 12, canvas.height);
  }

  const texture = new THREE.CanvasTexture(canvas);

  texture.colorSpace = THREE.SRGBColorSpace;

  texture.wrapS = THREE.RepeatWrapping;

  texture.wrapT = THREE.RepeatWrapping;

  texture.repeat.set(1, 3.5);

  texture.minFilter = THREE.LinearMipmapLinearFilter;

  texture.magFilter = THREE.LinearFilter;

  return texture;
}

/* =========================================================
   BUILDING TEXTURE
========================================================= */

function createBuildingTexture(seed = 1) {
  const canvas = document.createElement("canvas");

  canvas.width = 256;
  canvas.height = 512;

  const ctx = canvas.getContext("2d");

  const random = seededRandom(seed);

  const gradient = ctx.createLinearGradient(0, 0, 0, 512);

  gradient.addColorStop(0, "#253340");

  gradient.addColorStop(1, "#10161d");

  ctx.fillStyle = gradient;

  ctx.fillRect(0, 0, 256, 512);

  for (let y = 18; y < 500; y += 27) {
    for (let x = 12; x < 244; x += 27) {
      const lit = random() > 0.43;

      if (lit) {
        const warm = random() > 0.83;

        ctx.fillStyle = warm
          ? "rgba(255,211,140,0.67)"
          : "rgba(137,204,232,0.62)";
      } else {
        ctx.fillStyle = "rgba(8,14,20,0.72)";
      }

      ctx.fillRect(x, y, 16, 14);
    }
  }

  ctx.strokeStyle = "rgba(210,230,240,0.06)";

  ctx.lineWidth = 2;

  for (let y = 8; y < 512; y += 64) {
    ctx.beginPath();

    ctx.moveTo(0, y);

    ctx.lineTo(256, y);

    ctx.stroke();
  }

  const texture = new THREE.CanvasTexture(canvas);

  texture.colorSpace = THREE.SRGBColorSpace;

  texture.minFilter = THREE.LinearMipmapLinearFilter;

  texture.magFilter = THREE.LinearFilter;

  return texture;
}

