/* =========================================================
   MOUSE ENTER / LEAVE / MOVE
========================================================= */

function onPointerEnter(event) {
  if (isMobile.value) {
    return;
  }

  mouseState.inside = true;
  mouseState.ready = false;

  mouseState.x = event.clientX;

  mouseState.y = event.clientY;

  mouseState.previousX = event.clientX;

  mouseState.previousY = event.clientY;

  mouseState.lastMoveTime = performance.now();
}

function onPointerLeave() {
  mouseState.inside = false;
  mouseState.ready = false;

  mouseState.previousX = 0;
  mouseState.previousY = 0;
}

function onPointerMove(event) {
  if (isMobile.value || !mouseState.inside) {
    return;
  }

  const now = performance.now();

  mouseState.x = event.clientX;

  mouseState.y = event.clientY;

  /*
    Re-entering or a long event gap:
    establish a new baseline.
  */
  if (!mouseState.ready || now - mouseState.lastMoveTime > 120) {
    mouseState.previousX = event.clientX;

    mouseState.previousY = event.clientY;

    mouseState.ready = true;

    mouseState.lastMoveTime = now;

    return;
  }

  let dx = event.clientX - mouseState.previousX;

  let dy = event.clientY - mouseState.previousY;

  mouseState.previousX = event.clientX;

  mouseState.previousY = event.clientY;

  mouseState.lastMoveTime = now;

  /*
    Avoid giant camera jumps.
  */
  dx = THREE.MathUtils.clamp(dx, -45, 45);

  dy = THREE.MathUtils.clamp(dy, -45, 45);

  state.targetYaw += dx * MOUSE_SENSITIVITY_X;

  state.targetPitch -= dy * MOUSE_SENSITIVITY_Y;

  state.targetPitch = THREE.MathUtils.clamp(state.targetPitch, -1.18, 1.18);
}

/* =========================================================
   EDGE LOOK
========================================================= */

function updateMouseEdgeLook(delta) {
  if (isMobile.value || !mouseState.inside || !mouseState.ready) {
    return;
  }

  const width = window.innerWidth;

  const height = window.innerHeight;

  const x = mouseState.x;

  const y = mouseState.y;

  let edgeX = 0;
  let edgeY = 0;

  /*
    LEFT / RIGHT
  */
  if (x < MOUSE_EDGE_ZONE) {
    edgeX = -(MOUSE_EDGE_ZONE - x) / MOUSE_EDGE_ZONE;
  } else if (x > width - MOUSE_EDGE_ZONE) {
    edgeX = (x - (width - MOUSE_EDGE_ZONE)) / MOUSE_EDGE_ZONE;
  }

  /*
    TOP / BOTTOM

    You can keep the mouse near
    the top edge to continue looking up.
    It does not have to leave the page.
  */
  if (y < MOUSE_EDGE_ZONE) {
    edgeY = -(MOUSE_EDGE_ZONE - y) / MOUSE_EDGE_ZONE;
  } else if (y > height - MOUSE_EDGE_ZONE) {
    edgeY = (y - (height - MOUSE_EDGE_ZONE)) / MOUSE_EDGE_ZONE;
  }

  /*
    Smooth acceleration
  */
  state.targetYaw += edgeX * EDGE_YAW_SPEED * delta;

  state.targetPitch -= edgeY * EDGE_PITCH_SPEED * delta;

  state.targetPitch = THREE.MathUtils.clamp(state.targetPitch, -1.22, 1.22);

  /*
    Prevent target yaw from
    growing infinitely.
  */
  if (Math.abs(state.targetYaw) > Math.PI * 1000) {
    state.targetYaw =
      THREE.MathUtils.euclideanModulo(state.targetYaw + Math.PI, Math.PI * 2) -
      Math.PI;

    state.yaw =
      THREE.MathUtils.euclideanModulo(state.yaw + Math.PI, Math.PI * 2) -
      Math.PI;
  }
}

/* =========================================================
   FOCUS / VISIBILITY
========================================================= */

function onWindowBlur() {
  mouseState.inside = false;
  mouseState.ready = false;

  mouseState.previousX = 0;
  mouseState.previousY = 0;

  resetControls();
}

function onVisibilityChange() {
  if (document.hidden) {
    mouseState.inside = false;
    mouseState.ready = false;

    mouseState.previousX = 0;
    mouseState.previousY = 0;

    resetControls();
  }
}

/* =========================================================
   TOUCH LOOK
========================================================= */

function onTouchStart(event) {
  if (event.touches.length !== 1) {
    return;
  }

  const touch = event.touches[0];

  /*
    Mobile controls occupy the bottom.
  */
  if (touch.clientY > window.innerHeight - 180) {
    return;
  }

  touchLook.active = true;

  touchLook.x = touch.clientX;

  touchLook.y = touch.clientY;
}

function onTouchMove(event) {
  if (!touchLook.active || event.touches.length !== 1) {
    return;
  }

  const touch = event.touches[0];

  const dx = touch.clientX - touchLook.x;

  const dy = touch.clientY - touchLook.y;

  touchLook.x = touch.clientX;

  touchLook.y = touch.clientY;

  state.targetYaw += dx * 0.006;

  state.targetPitch -= dy * 0.004;

  state.targetPitch = THREE.MathUtils.clamp(state.targetPitch, -1.22, 1.22);
}

function onTouchEnd() {
  touchLook.active = false;
}

/* =========================================================
   KEYBOARD
========================================================= */

function onKeyDown(event) {
  if (Object.prototype.hasOwnProperty.call(keys, event.code)) {
    keys[event.code] = true;

    if (
      [
        "KeyW",
        "KeyA",
        "KeyS",
        "KeyD",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
      ].includes(event.code)
    ) {
      event.preventDefault();
    }
  }
}

function onKeyUp(event) {
  if (Object.prototype.hasOwnProperty.call(keys, event.code)) {
    keys[event.code] = false;
  }
}

/* =========================================================
   RESET CONTROLS
========================================================= */

function resetControls() {
  Object.keys(keys).forEach((key) => {
    keys[key] = false;
  });

  mobileForward.value = false;

  joystick.active = false;

  joystick.x = 0;
  joystick.y = 0;

  joystickVisual.value = {
    x: 0,
    y: 0,
  };
}

function startForward() {
  mobileForward.value = true;
}

function stopForward() {
  mobileForward.value = false;
}

/* =========================================================
   JOYSTICK
========================================================= */

function startJoystick(event) {
  const touch = event.touches[0];

  joystick.active = true;

  updateJoystick(touch.clientX, touch.clientY);
}

function moveJoystick(event) {
  if (!joystick.active) {
    return;
  }

  const touch = event.touches[0];

  updateJoystick(touch.clientX, touch.clientY);
}

function endJoystick() {
  joystick.active = false;

  joystick.x = 0;
  joystick.y = 0;

  joystickVisual.value = {
    x: 0,
    y: 0,
  };
}

function updateJoystick(clientX, clientY) {
  if (!joystickRef.value) {
    return;
  }

  const rect = joystickRef.value.getBoundingClientRect();

  const centerX = rect.left + rect.width / 2;

  const centerY = rect.top + rect.height / 2;

  let dx = clientX - centerX;

  let dy = clientY - centerY;

  const max = 42;

  const distance = Math.hypot(dx, dy);

  if (distance > max) {
    const factor = max / distance;

    dx *= factor;
    dy *= factor;
  }

  joystick.x = dx / max;

  joystick.y = dy / max;

  joystickVisual.value = {
    x: dx,
    y: dy,
  };
}

/* =========================================================
   PLAYER MOVEMENT
========================================================= */

function updatePlayer(delta) {
  forward.set(Math.sin(state.yaw), 0, -Math.cos(state.yaw));

  right.set(Math.cos(state.yaw), 0, Math.sin(state.yaw));

  movement.set(0, 0, 0);

  const keyboardForward =
    (keys.KeyW || keys.ArrowUp ? 1 : 0) - (keys.KeyS || keys.ArrowDown ? 1 : 0);

  const keyboardSide =
    (keys.KeyD || keys.ArrowRight ? 1 : 0) -
    (keys.KeyA || keys.ArrowLeft ? 1 : 0);

  const forwardInput =
    keyboardForward + (mobileForward.value ? 1 : 0) - joystick.y;

  const sideInput = keyboardSide + joystick.x;

  movement.addScaledVector(forward, forwardInput);

  movement.addScaledVector(right, sideInput);

  /*
    No actual input:
    player does not move.
  */
  if (movement.lengthSq() <= 0.0001) {
    camera.position.copy(player);

    return;
  }

  if (movement.lengthSq() > 1) {
    movement.normalize();
  }

  const speed = isMobile.value ? 7.4 : 10.2;

  player.addScaledVector(movement, speed * delta);

  player.x = THREE.MathUtils.clamp(player.x, -7.35, 7.35);

  player.z = THREE.MathUtils.clamp(player.z, ROAD_END_Z, ROAD_START_Z);

  camera.position.copy(player);
}

/* =========================================================
   STREET PROGRESS
========================================================= */

function updateStreetProgress() {
  const totalDistance = ROAD_START_Z - ROAD_END_Z;

  const travelled = ROAD_START_Z - player.z;

  const progress = THREE.MathUtils.clamp(
    (travelled / totalDistance) * 100,
    0,
    100,
  );

  streetProgress.value = Math.round(progress);

  streetEndReached.value = progress >= 99.5;
}

/* =========================================================
   CAMERA
========================================================= */

function updateCamera() {
  /*
    Shortest angular path prevents
    sudden jumps at ±PI.
  */
  const yawDifference =
    THREE.MathUtils.euclideanModulo(
      state.targetYaw - state.yaw + Math.PI,
      Math.PI * 2,
    ) - Math.PI;

  state.yaw += yawDifference * 0.12;

  state.pitch += (state.targetPitch - state.pitch) * 0.11;

  const distance = 20;

  const target = new THREE.Vector3();

  target.set(
    player.x + Math.sin(state.yaw) * Math.cos(state.pitch) * distance,

    player.y + Math.sin(state.pitch) * distance,

    player.z - Math.cos(state.yaw) * Math.cos(state.pitch) * distance,
  );

  camera.lookAt(target);
}

/* =========================================================
   CAR ANIMATION
========================================================= */

function updateCars(delta) {
  cars.forEach((car) => {
    car.group.position.z += car.speed * delta * 60;

    if (car.direction > 0 && car.group.position.z > 30) {
      car.group.position.z = -650;
    }

    if (car.direction < 0 && car.group.position.z < -650) {
      car.group.position.z = 30;
    }

    car.wheels.forEach((wheel) => {
      wheel.rotation.x -= car.speed * 1.75;
    });
  });
}

/* =========================================================
   PEDESTRIAN ANIMATION
========================================================= */

function updatePedestrians(time) {
  pedestrians.forEach((person) => {
    const t = time * 0.0011 + person.offset;

    person.group.position.z = person.baseZ + Math.sin(t) * 2.8;

    person.group.position.x = person.baseX + Math.sin(t * 0.72) * 0.35;

    person.group.rotation.y = Math.sin(t) * 0.23;

    const swing = Math.sin(t * 2.5) * 0.08;

    if (person.group.children[2]) {
      person.group.children[2].rotation.z = swing;
    }

    if (person.group.children[3]) {
      person.group.children[3].rotation.z = -swing;
    }
  });
}

/* =========================================================
   MAIN LOOP
========================================================= */

function animate() {
  animationFrame = requestAnimationFrame(animate);

  const delta = Math.min(clock.getDelta(), 0.05);

  const elapsed = clock.elapsedTime;

  /*
    Edge look happens every frame
    while the mouse is near an edge.
  */
  updateMouseEdgeLook(delta);

  updatePlayer(delta);
  updateCamera();

  updateCars(delta);

  updatePedestrians(elapsed * 1000);

  updateStreetProgress();

  renderer.render(scene, camera);
}

/* =========================================================
   RESIZE
========================================================= */

function onResize() {
  if (!camera || !renderer) {
    return;
  }

  isMobile.value = window.innerWidth < 820;

  camera.aspect = window.innerWidth / window.innerHeight;

  camera.updateProjectionMatrix();

  renderer.setSize(window.innerWidth, window.innerHeight, false);

  renderer.setPixelRatio(
    Math.min(window.devicePixelRatio || 1, isMobile.value ? 1.2 : 1.55),
  );

  mouseState.ready = false;
}

/* =========================================================
   INIT
========================================================= */

async function initThree() {
  await nextTick();

  isMobile.value = window.innerWidth < 820;

  scene = new THREE.Scene();

  scene.background = new THREE.Color(0x07101a);

  scene.fog = new THREE.Fog(0x07101a, 95, 560);

  camera = new THREE.PerspectiveCamera(
    62,
    window.innerWidth / window.innerHeight,
    0.08,
    760,
  );

  camera.position.copy(player);

  renderer = new THREE.WebGLRenderer({
    canvas: canvasRef.value,
    antialias: !isMobile.value,
    alpha: false,
    powerPreference: "high-performance",
  });

  renderer.setPixelRatio(
    Math.min(window.devicePixelRatio || 1, isMobile.value ? 1.2 : 1.55),
  );

  renderer.setSize(window.innerWidth, window.innerHeight, false);

  renderer.outputColorSpace = THREE.SRGBColorSpace;

  renderer.toneMapping = THREE.NoToneMapping;

  renderer.toneMappingExposure = 1;

  renderer.shadowMap.enabled = false;

  clock = new THREE.Clock();

  /* City lighting */
  const ambient = new THREE.AmbientLight(0xa9c7d8, 0.92);

  scene.add(ambient);

  const hemisphere = new THREE.HemisphereLight(0xadd4eb, 0x0f151c, 1.05);

  scene.add(hemisphere);

  createWorld();

  const canvas = canvasRef.value;

  /*
    Pointer events are bound to the
    actual canvas only.
  */
  canvas.addEventListener("pointerenter", onPointerEnter, {
    passive: true,
  });

  canvas.addEventListener("pointerleave", onPointerLeave, {
    passive: true,
  });

  canvas.addEventListener("pointermove", onPointerMove, {
    passive: true,
  });

  window.addEventListener("resize", onResize);

  window.addEventListener("touchstart", onTouchStart, {
    passive: true,
  });

  window.addEventListener("touchmove", onTouchMove, {
    passive: true,
  });

  window.addEventListener("touchend", onTouchEnd, {
    passive: true,
  });

  window.addEventListener("keydown", onKeyDown);

  window.addEventListener("keyup", onKeyUp);

  window.addEventListener("blur", onWindowBlur);

  document.addEventListener("visibilitychange", onVisibilityChange);

  animate();
}

/* =========================================================
   CLEANUP
========================================================= */

function disposeScene() {
  cancelAnimationFrame(animationFrame);

  const canvas = canvasRef.value;

  if (canvas) {
    canvas.removeEventListener("pointerenter", onPointerEnter);

    canvas.removeEventListener("pointerleave", onPointerLeave);

    canvas.removeEventListener("pointermove", onPointerMove);
  }

  window.removeEventListener("resize", onResize);

  window.removeEventListener("touchstart", onTouchStart);

  window.removeEventListener("touchmove", onTouchMove);

  window.removeEventListener("touchend", onTouchEnd);

  window.removeEventListener("keydown", onKeyDown);

  window.removeEventListener("keyup", onKeyUp);

  window.removeEventListener("blur", onWindowBlur);

  document.removeEventListener("visibilitychange", onVisibilityChange);

  if (scene) {
    scene.traverse((object) => {
      if (object.geometry) {
        object.geometry.dispose();
      }

      if (object.material) {
        const materials = Array.isArray(object.material)
          ? object.material
          : [object.material];

        materials.forEach((material) => {
          if (material.map) {
            material.map.dispose();
          }

          material.dispose();
        });
      }
    });
  }

  if (renderer) {
    renderer.dispose();
  }

  cars.length = 0;
  pedestrians.length = 0;

  scene = null;
  camera = null;
  renderer = null;
}

/* =========================================================
   LIFECYCLE
========================================================= */

onMounted(() => {
  initThree();
});

onBeforeUnmount(() => {
  disposeScene();
});
